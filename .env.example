# Copy to .env for local development. On Railway, set these in the service's
# Variables tab instead (never commit real values).

NODE_ENV=development
PORT=3000

# Public URL of the web app (no trailing slash). Used for the OAuth redirect URI
# and the "open in app" link in calendar events.
APP_BASE_URL=http://localhost:3000

# Postgres connection string (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5432/motion_replicator

# Login password for the app (single user)
APP_PASSWORD=change-me

# Random strings. Generate each with: npm run gen-key
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional scheduler settings (defaults shown) ----
# TASKS_CALENDAR_NAME=Tasks
# PLANNING_DAYS=7
# BUFFER_MINUTES=10
# SPLIT_THRESHOLD_MINUTES=90
# MIN_CHUNK_MINUTES=30
# GRANULARITY_MINUTES=5
# SCHEDULE_LATE_TASKS=true
# CRON_LOCAL_HOUR=6
# ISO weekday (1=Mon .. 7=Sun) -> list of [start, end] local times
# WORKING_HOURS_JSON={"1":[["09:00","17:30"]],"2":[["09:00","17:30"]],"3":[["09:00","17:30"]],"4":[["09:00","17:30"]],"5":[["09:00","17:30"]],"6":[["10:00","14:00"]],"7":[]}
